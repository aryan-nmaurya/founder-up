# FounderUp environment (plan §65)
# Copy to .env.local and fill in. Never commit .env.local.

# Public base URL, no trailing slash. Used for canonical URLs, OG cards and
# the share link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Project URL and anon key are public by design and reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role bypasses RLS. Server only. Never expose this to the browser,
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay -------------------------------------------------------------
# Key ID is sent to Checkout in the browser; the secret never leaves the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set this to the signing secret you configure on the Razorpay webhook.
# Without it the webhook endpoint refuses every request.
RAZORPAY_WEBHOOK_SECRET=

# --- Optional -------------------------------------------------------------
# Used only to estimate Rank Points for USD amounts in the UI. The real
# conversion always comes from Razorpay's base_amount at capture time.
NEXT_PUBLIC_USD_INR_ESTIMATE=88

NEXT_PUBLIC_CONTACT_EMAIL=hello@founderup.com
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=FounderUp
NEXT_PUBLIC_LEGAL_JURISDICTION=India

# Error monitoring and product analytics (plan §6). Both are no-ops if unset.
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
